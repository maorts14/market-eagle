# Local development only. Copy to infra/.env; change these values for your machine.
APP_DB_USER=market_eagle
APP_DB_PASSWORD=local-market-eagle-only
APP_DB_NAME=market_eagle
APP_DB_PORT=55432
APP_DB_READONLY_USER=market_eagle_reader
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=local-temporal-only
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8080
# Set the key only in ignored infra/.env. The agent worker reads it; the API does not.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
