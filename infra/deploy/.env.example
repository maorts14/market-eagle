# Copy outside Git and replace every reviewed value before a host rollout.
# Run the reviewed one-shot bootstrap sequence in README.md before starting the runtime.
NVME_DATA_DIR=/var/lib/market-eagle
SECRETS_DIR=/etc/market-eagle/secrets
BACKEND_IMAGE=market-eagle/backend:reviewed-commit
WEB_IMAGE=market-eagle/web:reviewed-commit
SOURCE_REVISION=reviewed-commit
WEB_PORT=18080
TEMPORAL_UI_PORT=18081
MARKET_EAGLE_SOURCE=reviewed-source
MARKET_EAGLE_FEED=reviewed-feed
MARKET_EAGLE_PRICE_BASIS=reviewed-basis
MARKET_EAGLE_EXCHANGE=reviewed-exchange
# For an explicitly approved five-stock test only, set the published sample snapshot ID.
# MARKET_EAGLE_PRIVATE_SAMPLE_SNAPSHOT_ID=alpaca-sample-v1-reviewed-stage-id
ALPACA_MIN_REQUEST_INTERVAL_SECONDS=1
